# Required in production. Use a unique random password (16+ chars) and secret (32+ chars).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SECRET=replace-with-at-least-32-random-characters
# Keep ADMIN_SECRET stable: it also protects encrypted TOTP/AI/payment secrets.
# Optional AI integration (keys may also be configured encrypted from Admin > AI Studio)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Never enable demo catalog reset in production.
ALLOW_DEMO_CATALOG_RESET=false

# Optional scheduled cleanup for unpaid online orders (invoke POST /api/cron/expire-unpaid).
# Use a random secret of at least 24 characters in production.
CRON_SECRET=replace-with-a-long-random-cron-secret
UNPAID_ORDER_TTL_MINUTES=30

# Customer SMS OTP login. Configure a provider endpoint accepting JSON { receptor, message }
# with Bearer API key authentication. Development only returns a test OTP in the local UI.
SMS_API_URL=
SMS_API_KEY=
