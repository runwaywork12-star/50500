# ─── عمومی ───────────────────────────────────────────────
NODE_ENV=production
PUBLIC_ORIGIN=https://50500.shop
PORT=8080

# ─── پایگاه داده ─────────────────────────────────────────
# رمز را با: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgres://store:CHANGE_ME_strong_db_password@db:5432/store50500
PG_POOL_MAX=10
PGSSL=false

# ─── امنیت (تولید بدون این‌ها بالا نمی‌آید) ────────────────
# حداقل ۱۶ کاراکتر: openssl rand -base64 24
ADMIN_PASSWORD=CHANGE_ME_at_least_16_chars
# حداقل ۳۲ کاراکتر و ثابت بماند: openssl rand -base64 48
ADMIN_SECRET=CHANGE_ME_at_least_32_random_chars_stable
SESSION_TTL_HOURS=12
# حداقل ۲۴ کاراکتر برای cron انقضای سفارش‌ها
CRON_SECRET=CHANGE_ME_at_least_24_chars
UNPAID_ORDER_TTL_MINUTES=30

# ─── فضای ذخیره‌سازی ──────────────────────────────────────
# local | s3   (s3 = هر سرویس سازگار با S3 مثل لیارا/آروان/مینو)
STORAGE_DRIVER=local
STORAGE_DIR=/data/uploads
MAX_UPLOAD_BYTES=8388608
# S3_ENDPOINT=https://storage.iran.liara.space
# S3_BUCKET=50500-media
# S3_REGION=default
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=https://50500-media.storage.iran.liara.space

# ─── پیامک (ورود با کد یک‌بارمصرف) ─────────────────────────
# SMS_API_URL=
# SMS_API_KEY=
